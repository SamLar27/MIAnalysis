result <- MI_spline(
data = Data_Oracle,
#Outcome
outcome_var = "Number_severe_asthma_attacks_during_followup",
#Variable on X axis
variable_x = "Blood_Eos_baseline_x10_9_cells_per_L_imputated",
prediction_range = c(0.01, 0.99),
#Subgroups
subgroups = "FEV1_preBD_Baseline_by_group_imputated",
subgroup_as_factor = TRUE,
subgroup_labels = c(">=70% test", "60-<70%","50-<60%","<50%"),
#Covariables
covariables = c("Age_imputated", "Gender_imputated", "BMI_per_5_imputated",
"Treatment_step_1and2", "ACQ_baseline_score_mean_imputated",
"Any_severe_attack_previous_12m_0no_1yes_imputated", "FeNO_Log_imputated"),
#As trial factor
trial_factor = "Yes",
trial_col = "Enrolled_Trial_name",
#Follow-up offset
followup_offset = "Yes",
followup_col = "Follow_up_duration_days",
#Calculation of derivative:
calculate_derivatives = TRUE,
derivative_points = seq(from = 0.05, to = 1, by = 0.05),
#Graph parameters
plot_options = list(
#Title of the graph
title = "Association Between Eosinophil Count and Asthma Attacks",
subtitle = "Stratified by history of severe asthma attacks in past 12 months",
caption = "Model: Negative Binomial, adjusted for trial, follow-up time, and covariates.",
#Axis label
x_lab = "Blood eosinophil count (× 10^9 cells/L)",
y_lab = "Estimated Annualised Severe Asthma Attack Rate",
#Axis range
use_log_x = TRUE,
use_superscript = TRUE,  # Add this line to enable superscript formatting
x_breaks = c(0.1, 0.15, 0.3, 0.6, 1, 1.5),
x_limits = c(0.1, 1.5),
y_breaks = c(0.5, 1, 1.5, 2, 2.5, 3),
y_limits = c(0.1, 2),
#Spline parameters
colors = c("black", "darkred","darkblue","orange"),
fill_colors = c("darkgrey", "darkred","darkblue","orange"),
line_types = c("solid", "solid", "solid", "solid"),
line_size = 1,
ribbon_alpha = 0.3,
#Adding vertical line
vline = c(0.3),
vline_color = "red",
vline_type = "dotted",
#Adding horizontal line
hline = c(1),
hline_color = "red",
hline_type = "dotted",
#Adding Annotations
annotations = list(
list(geom = "text", x = 0.3, y = 1.8, label = "Clinical threshold", color = "blue", size = 5, fontface = "bold"),
list(geom = "text", x = 1.0, y = 1.5, label = "Elevated risk", color = "darkred", size = 4, fontface = "italic")
),
#Adding Shadded area
shaded_areas = list(
list(xmin = 0.15, xmax = 0.3, fill = "lightblue", alpha = 0.3),
list(xmin = 0.3, xmax = 0.6, fill = "lightblue", alpha = 0.3)
),
#Legend parameters
legend_title = "Any attack in past 12 m",
#legend_labels = c("No attack history", "Previous attack history","",""),
include_counts = TRUE,
#Title/subtitle/caption format
theme_plot_title = ggplot2::element_text(face = "bold", size = 18, colour = "black", hjust = 0.5),
theme_plot_subtitle = ggplot2::element_text(face = "italic", size = 14, colour = "gray30", hjust = 0.5),
theme_plot_caption = ggplot2::element_text(size = 10, color = "gray40", face = "italic", hjust = 0),
#Axis text format
theme_axis_title_x = ggplot2::element_text(face = "bold", size = 16),
theme_axis_title_y = ggplot2::element_text(face = "bold", size = 16),
theme_axis_text_x = ggplot2::element_text(face = "bold", size = 14),
theme_axis_text_y = ggplot2::element_text(face = "bold", size = 14),
#Axis line format
theme_axis_line = ggplot2::element_line(colour = "black", size = 1.2),
#Legend format
legend_position = c(0.25, 0.8),
theme_legend_title = ggplot2::element_text(face = "bold", size = 14),
theme_legend_text = ggplot2::element_text(face = "bold", size = 10),
theme_legend_background = ggplot2::element_rect(fill = "lightyellow", colour = "black", size = 0.5),
#Panel background
theme_panel_background = ggplot2::element_rect(fill = "white", colour = NA,size = NULL,linetype = NULL),
#Major grid parameters
theme_panel_grid_major = ggplot2::element_line(colour = "gray90",size = 0.2,linetype = "dashed"),
theme_panel_grid_minor = ggplot2::element_blank(),  # No minor grid lines
# Margin settings
theme_plot_margin = ggplot2::margin(t = 10, r = 10, b = 10, l = 10)
)
)
result$plot
