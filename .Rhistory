repair_package <- function(pkg = "fs") {
message("🧹 Nettoyage du package corrompu : ", pkg)
# 1. Supprimer le package s'il est déjà installé
if (pkg %in% installed.packages()) {
message("→ Suppression du package existant...")
try(remove.packages(pkg), silent = TRUE)
}
# 2. Réinstallation propre depuis la source
message("→ Réinstallation depuis la source (compilation propre)...")
try(install.packages(pkg, type = "source"), silent = FALSE)
# 3. Confirmer que l'installation a réussi
if (pkg %in% installed.packages()) {
message("✅ Package ", pkg, " réparé avec succès.")
} else {
message("❌ Échec de la réparation du package ", pkg, ".")
}
# 4. Suggérer de redémarrer la session
message("\n🔁 Pensez à redémarrer la session R (Ctrl + Shift + F10) avant de relancer `devtools::check()`.")
}
repair_package("fs")
install.packages(pkg, type = "source")
getwd()
usethis::use_git()
