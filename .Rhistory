# Load required libraries
library(ggplot2)
library(dplyr)
# Define custom order for the TrialType factor
trial_type_order <- c(
"INTERVENTIONAL PARALLEL",
"INTERVENTIONAL SINGLE_GROUP",
"INTERVENTIONAL CROSSOVER",
"INTERVENTIONAL FACTORIAL",
"INTERVENTIONAL SEQUENTIAL",
"INTERVENTIONAL NA",
"OBSERVATIONAL"
)
# Create the stacked bar plot WITHOUT any geom_text layer
p1 <- ggplot(trials_by_year_type, aes(x = CompletionYear, y = NumberOfTrials, fill = TrialType)) +
geom_bar(stat = "identity", position = "stack") +
labs(
title = "Number of Completed Clinical Trials per Year",
subtitle = "Asthma Clinical Trials by Study Type and Intervention Model",
x = "Year of Completion",
y = "Number of Trials",
fill = "Trial Type"
) +
theme_minimal() +
theme(
plot.title = element_text(size = 16, face = "bold"),
plot.subtitle = element_text(size = 12),
axis.text.x = element_text(angle = 45, hjust = 1),
panel.grid.minor = element_blank(),
legend.position = "bottom"
) +
scale_x_continuous(breaks = seq(min(trials_by_year_type$CompletionYear),
max(trials_by_year_type$CompletionYear),
by = 2))
trials_by_year_type
