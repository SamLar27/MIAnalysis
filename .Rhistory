#Per trial analysis
library(MIAnalysis)
# Initialize list to store results per trial
results_by_trial_MI <- list()
# Loop through each trial
for (trial in unique(Data_Oracle_only_with_asthma_history_yes_or_no$Enrolled_Trial_name)) {
# Subset the data
trial_data <- subset(Data_Oracle_only_with_asthma_history_yes_or_no, Enrolled_Trial_name == trial)
# Skip if too small
if (nrow(trial_data) < 30) next
# Dynamically select variables based on their presence in the data
pred_vars <- c(
"FeNO_p_imputated:Any_severe_attack_previous_12m_0no_1yes_imputated",
"Age_imputated", "Gender_imputated", "BMI_imputated",
"ACQ_baseline_score_mean_imputated", "FEV1_preBD_per10_Baseline_imputated",
"FeNO_p_imputated", "BEC_p_imputated"
)
# Only include variables with >1 level in this trial
if (length(unique(trial_data$Treatment_step_1and2)) > 1) {
pred_vars <- c(pred_vars, "Treatment_step_1and2")
}
if (length(unique(trial_data$Any_severe_attack_previous_12m_0no_1yes_imputated)) > 1) {
pred_vars <- c(pred_vars, "Any_severe_attack_previous_12m_0no_1yes_imputated")
}
# Skip if interaction term becomes invalid (e.g., only one level for one part of the interaction)
if (!("FeNO_p_imputated:Any_severe_attack_previous_12m_0no_1yes_imputated" %in% pred_vars)) next
# Fit model
trial_result <- MI_estimates(
data = trial_data,
outcome_var = "Number_severe_asthma_attacks_during_followup",
predictor_vars = pred_vars,
imp_col = ".imp",
followup_offset = "Yes",
followup_col = "Follow_up_duration_days",
trial_factor = "No",  # Already filtered to one trial
model_type = "nb"
)
# Extract interaction term
interaction_result <- trial_result %>%
filter(is_interaction == "TRUE")
# Add trial info and store
if (nrow(interaction_result) > 0) {
interaction_result$trial <- paste0(trial, " (N=", nrow(trial_data)/10, ")")
results_by_trial_MI[[trial]] <- interaction_result
}
}
# Combine all results
results_per_trial <- do.call(rbind, results_by_trial_MI)
results_overall <- Interaction_FeNO_X_Attack_only_trials_w_attack %>%
dplyr::rename(trial = term) %>%
mutate(trial = paste0("Pooled_effect"," (N=", nrow(Data_Oracle_only_with_asthma_history_yes_or_no)/10, ")"))
results_df_with_all<- rbind(results_per_trial[,c("trial","exp_estimate","exp_CI95_lower","exp_CI95_upper","p.value")],
results_overall[,c("trial","exp_estimate","exp_CI95_lower","exp_CI95_upper","p.value")]
)
results_per_trial
# Define the file path and name
output_path <- "/Users/macbookpro/Documents/École/Doctorat_recherche/Articles/Interaction_analysis/Figures_interaction/Figures_interactions_all/Sensitivity_analysis_Forest_plot_interaction_FeNO_X_Attack_per_trial.png"
# Open a PNG device with high resolution
png(filename = output_path, width = 9, height = 6, units = "in", res = 300)
# In forrest plot -> View the results data frame
forplo(as.data.frame(results_df_with_all[,c("exp_estimate","exp_CI95_lower","exp_CI95_upper")]),
#Define the units
em="aRR",
#Define the labels
row.labels = results_df_with_all$trial,
left.align=FALSE,
#Define the groups
groups=c(rep(1,nrow(results_df_with_all)-1),2),
grouplabs=c('Trial name',"Overall"),
#Define the limits of the X axis
xlim= c(0.1,50),
#Define the arrows
favorlabs=c('Negative Interaction','Positive Interaction'),
add.arrow.left=TRUE,
add.arrow.right=TRUE,
arrow.left.length=7.5,
arrow.right.length=13,
#Remove the left bar
left.bar= FALSE,
#Adding the p-value
pval=p_round(results_df_with_all[,"p.value"], digits = 2),
ci.sep="-",
#Define the shading
shade.every=1,
shade.col='gray',
#Define the margin
margin.left=10,
margin.right=8,
margin.bottom = 1,
#Characteristics of the points (char is equivalent of pch)
char=20,
size=1.5,
#Characteristic of the error bar (color when not significant)
insig.col="grey",
diamond=nrow(results_df_with_all),
diamond.line = FALSE
)
library(metafor)
# Calculate standard errors from confidence intervals
results_per_trial
# Perform random-effects meta-analysis using metafor
meta_res <- rma(yi = estimate, sei = std.error, data = results_per_trial,
slab = trial, method = "REML")
# Print metafor results
cat("\n==== Metafor Package Results ====\n")
print(meta_res)
I2 <- meta_res$I2          # I² statistic
Q <- meta_res$QE
Q_pval <- meta_res$QEp
# Express I^2
text(
x = 0.035,  # Adjust x based on your plot's x-axis range
y = 1.3,  # Adjust y to a position just below the last row
labels = paste("I² =", round(I2 / 100, 2), sep = ""),
cex = 0.8,  # Font size
font = 1,   # Bold font
col = "black"  # Text color
)
# Express Q
text(
x = 0.024,  # Adjust x based on your plot's x-axis range
y = 0.7,  # Adjust y to a position just below the last row
labels = paste("Q =", round(Q, 2)," (p=",round(Q_pval, 2),")", sep = ""),
cex = 0.8,  # Font size
font = 1,   # Bold font
col = "black"  # Text color
)
dev.off()
meta_res_ml <- rma(yi = estimate, sei = std.error,
data = results_per_trial,
random = ~ 1 | trial, method = "REML")
summary(meta_res_ml)
meta_res_ml <- rma(yi = estimate, sei = std.error,
data = results_per_trial,
random = ~ 1 | trial, method = "REML")
meta_res_ml <- rma.mv(yi = estimate,
V = std.error^2,   # variance = std.error²
random = ~ 1 | trial,
data = results_per_trial,
method = "REML")
summary(meta_res_ml)
meta_res_combined <- rma.mv(yi = estimate,
V = std.error^2,
mods = ~ intervention_type + mean_age,
random = ~ 1 | trial,
data = results_per_trial,
method = "REML")
meta_res_ml <- rma.mv(yi = estimate,
