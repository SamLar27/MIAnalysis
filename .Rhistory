filter(all_abnormal) %>%
pull(Concentration_label)
if (length(fully_abnormal_concs) > 0) {
abnormal_line_data <- compound_data %>%
filter(Concentration_label %in% fully_abnormal_concs)
single_plot <- single_plot + geom_line(
data = abnormal_line_data,
aes(x = Time_min, y = mean, group = Concentration_label),
color = "grey50", size = 0.8, alpha = 0.7
)
}
}
}
single_plot <- single_plot +
scale_color_manual(
name = paste0("[", compound_name, "]"),
values = comp_palette,
labels = compound_labels,
breaks = breaks_order,
guide = guide_legend(
title = paste0("[", compound_name, "]"),
override.aes = list(size = 4),
title.theme = element_text(face = "bold", size = 12)
)
)
if (Outcome_format == "Normalized") {
single_plot <- single_plot + geom_hline(yintercept = 1, linetype = "dashed", color = "black", alpha = 0.6)
}
# Appliquer les limites et ticks personnalisés à la fin
single_plot <- apply_custom_limits_and_ticks(single_plot, global_y_limits)
return(single_plot)
}
# ===== DÉBUT DU TRAITEMENT PRINCIPAL =====
full_plot_data <- purrr::map_dfr(Compound, function(compound_name) {
data_path <- BRET_data[[Bret_type]][[Donor]][[Acceptor]][[Others_transfection]][[Substrate]][[compound_name]][[N]][[Outcome]][[Outcome_format]]
mean_df <- data_path[[Mean_format]]
# Sélectionner le type d'erreur selon l'argument
if (Error_bar_type == "sd") {
error_df <- data_path[["sd"]]
error_col_name <- "sd"
} else {
error_df <- data_path[["sem"]]
error_col_name <- "sem"
}
combined_df <- mean_df %>%
rename(mean = mean) %>%
left_join(error_df %>% rename(error = !!sym(error_col_name)), by = c("Time_min", "Concentration")) %>%
mutate(
Time_min = as.numeric(Time_min ),
Compound = compound_name,
legend_group = compound_name
)
# Appliquer le filtrage temporel dès le début si spécifié
if (!is.null(Time_window)) {
min_time <- Time_window[1]
max_time <- Time_window[2]
combined_df <- combined_df %>%
filter(Time_min >= min_time & Time_min <= max_time)
}
return(combined_df)
})
# Traitement des données avec donor count anormal
if (Remove_abnormal_donor_count || Color_abnormal_donor_count) {
donor_normalized_data <- purrr::map_dfr(Compound, function(compound_name) {
donor_path <- BRET_data[[Bret_type]][[Donor]][[Acceptor]][[Others_transfection]][[Substrate]][[compound_name]][[N]][["Donor_count"]][["Normalized"]]
donor_mean_df <- donor_path[[Mean_format]]
donor_mean_df %>%
rename(donor_normalized = mean) %>%
mutate(
Time_min = as.numeric(Time_min),
Compound = compound_name
) %>%
select(`Time_min`, Concentration, donor_normalized, Compound)
})
full_plot_data <- full_plot_data %>%
left_join(donor_normalized_data, by = c("Time_min", "Concentration", "Compound"))
if (Remove_abnormal_donor_count) {
full_plot_data <- full_plot_data %>%
filter(is.na(donor_normalized) | (donor_normalized >= Minimal_donor_count & donor_normalized <= Maximal_donor_count)) %>%
select(-donor_normalized)
} else if (Color_abnormal_donor_count) {
full_plot_data <- full_plot_data %>%
mutate(
is_abnormal = !is.na(donor_normalized) & (donor_normalized < Minimal_donor_count | donor_normalized > Maximal_donor_count)
) %>%
select(-donor_normalized)
}
}
if (Outcome_format %in% c("Delta", "Normalized")) {
full_plot_data <- full_plot_data %>% filter(Concentration != "Veh")
}
# Filtrer par concentrations sélectionnées ou par plages si spécifié
if (!is.null(Selected_concentrations) || !is.null(Concentration_ranges)) {
filtered_data <- data.frame()
for (compound_name in Compound) {
compound_data <- full_plot_data %>% filter(Compound == compound_name)
if (!is.null(Selected_concentrations) && compound_name %in% names(Selected_concentrations)) {
selected_concs <- Selected_concentrations[[compound_name]]
compound_data <- compound_data %>% filter(Concentration %in% selected_concs)
} else if (!is.null(Concentration_ranges) && compound_name %in% names(Concentration_ranges)) {
range_info <- Concentration_ranges[[compound_name]]
min_conc <- range_info[1]
max_conc <- range_info[2]
compound_data <- compound_data %>%
filter(
(Concentration == "Veh" & Outcome_format == "Raw") |
(Concentration != "Veh" &
sapply(Concentration, extract_concentration_value) >= min_conc &
sapply(Concentration, extract_concentration_value) <= max_conc)
)
}
filtered_data <- rbind(filtered_data, compound_data)
}
full_plot_data <- filtered_data
}
full_plot_data <- full_plot_data %>%
mutate(Concentration_label = paste(Compound, Concentration, sep = "_"))
compounds_with_data <- Compound[Compound %in% unique(full_plot_data$Compound)]
# Si Dose_response = TRUE, créer des courbes dose-réponse
if (Dose_response) {
return(create_dose_response_plots(full_plot_data, compounds_with_data, compound_colors,
Selected_timepoints, Outcome, Outcome_format,
Error_bar_type, Separate_plots, extract_concentration_value,
add_sigmoid, sigmoid_params))
}
# Si Separate_plots = TRUE, créer un graphique pour chaque composé
if (Separate_plots) {
# Calculer les limites globales de l'axe Y avant de créer les graphiques individuels
# La fonction calculate_global_y_limits vérifiera automatiquement si Y_lim est défini
global_y_limits <- calculate_global_y_limits(full_plot_data)
plot_list <- list()
for (i in seq_along(compounds_with_data)) {
compound_name <- compounds_with_data[i]
compound_plot <- create_single_compound_plot(
full_plot_data, compound_name, compound_colors, add_lines,
Color_abnormal_donor_count, Outcome_format, Outcome,
extract_concentration_value, format_concentration_expr,
global_y_limits  # Passer les limites globales (qui peuvent être Y_lim)
)
plot_list[[compound_name]] <- compound_plot
}
return(plot_list)
}
# Créer un graphique combiné (comportement original)
# Ajouter les points de base avant de créer le graphique
full_plot_data <- add_baseline_points(full_plot_data, Outcome_format)
p <- ggplot() +
labs(
x = "Time (min)",
y = create_y_axis_title(Outcome, Outcome_format)
) +
theme_minimal(base_size = 14) +
theme(
axis.title.x = element_text(face = "bold"),
axis.title.y = element_text(face = "bold"),
legend.text.align = 0,
legend.box = "horizontal",
legend.box.just = "top",
legend.justification = "top",
legend.box.margin = margin(t = 0, r = 0, b = 0, l = 0),
legend.direction = "vertical",
axis.line.x = element_line(color = "black", size = 0.5),
axis.line.y = element_line(color = "black", size = 0.5),
axis.ticks.x = element_line(color = "black", size = 0.5),
axis.ticks.y = element_line(color = "black", size = 0.5),
axis.ticks.length = unit(0.2, "cm"),
panel.grid.major = element_line(color = "grey90", size = 0.3),
panel.grid.minor = element_line(color = "grey95", size = 0.2)
)
for (i in seq_along(compounds_with_data)) {
compound_name <- compounds_with_data[i]
compound_data <- full_plot_data %>%
filter(Compound == compound_name)
# Séparer les données normales et anormales si coloration activée
if (Color_abnormal_donor_count && "is_abnormal" %in% names(compound_data)) {
fully_abnormal_concs <- compound_data %>%
group_by(Concentration_label) %>%
summarise(all_abnormal = all(is_abnormal), .groups = "drop") %>%
filter(all_abnormal) %>%
pull(Concentration_label)
normal_data <- compound_data %>%
filter(!is_abnormal | Concentration_label %in% fully_abnormal_concs)
abnormal_data <- compound_data %>%
filter(is_abnormal & !Concentration_label %in% fully_abnormal_concs)
} else {
normal_data <- compound_data
abnormal_data <- data.frame()
}
# Créer les couleurs pour ce composé
compound_concs <- compound_data %>%
distinct(Concentration) %>%
mutate(conc_value = sapply(Concentration, extract_concentration_value)) %>%
arrange(conc_value) %>%
pull(Concentration)
if (!is.null(compound_colors) && compound_name %in% names(compound_colors)) {
base_color <- compound_colors[[compound_name]]
if (length(compound_concs) == 1) {
comp_palette <- base_color
} else {
light_color <- colorspace::lighten(base_color, amount = 0.8)
comp_palette <- colorRampPalette(c(light_color, base_color))(length(compound_concs))
}
} else {
comp_palette <- colorRampPalette(c("#FFCCCC", "#990000"))(length(compound_concs))
}
names(comp_palette) <- paste(compound_name, compound_concs, sep = "_")
# Modifier les couleurs pour les concentrations entièrement anormales
if (Color_abnormal_donor_count && "is_abnormal" %in% names(compound_data)) {
for (conc in compound_concs) {
conc_label <- paste(compound_name, conc, sep = "_")
conc_data <- compound_data %>% filter(Concentration_label == conc_label)
if (nrow(conc_data) > 0 && all(conc_data$is_abnormal)) {
comp_palette[conc_label] <- "grey50"
}
}
}
# Créer les labels pour ce composé
compound_labels <- purrr::map(
compound_concs,
function(conc) format_concentration_expr("", conc)
)
names(compound_labels) <- paste(compound_name, compound_concs, sep = "_")
breaks_order <- paste(compound_name, compound_concs, sep = "_")
# Calculer la largeur adaptative des barres d'erreur
time_range <- max(full_plot_data$Time_min) - min(full_plot_data$Time_min)
error_bar_width <- max(0.1, time_range * 0.02)
# Ajouter les points et lignes pour ce composé
if (add_lines && nrow(compound_data) > 0) {
p <- p + geom_line(
data = compound_data,
aes(x = Time_min, y = mean, color = Concentration_label),
size = 0.8, alpha = 0.7
)
}
if (nrow(normal_data) > 0) {
p <- p +
geom_point(
data = normal_data,
aes(x = Time_min, y = mean, color = Concentration_label),
size = 2
) +
geom_errorbar(
data = normal_data,
aes(x = Time_min, ymin = mean - error, ymax = mean + error, color = Concentration_label),
width = error_bar_width
)
}
# Ajouter les points anormaux en gris si option activée
if (Color_abnormal_donor_count && nrow(abnormal_data) > 0) {
p <- p +
geom_point(
data = abnormal_data,
aes(x = Time_min, y = mean),
color = "grey50", size = 2
) +
geom_errorbar(
data = abnormal_data,
aes(x = Time_min, ymin = mean - error, ymax = mean + error),
color = "grey50", width = error_bar_width
)
# Ajouter les lignes grises pour les concentrations entièrement anormales
if (add_lines) {
# Identifier les concentrations entièrement anormales
fully_abnormal_concs <- compound_data %>%
filter(Time_min > 0) %>%
group_by(Concentration_label) %>%
summarise(all_abnormal = all(is_abnormal), .groups = "drop") %>%
filter(all_abnormal) %>%
pull(Concentration_label)
if (length(fully_abnormal_concs) > 0) {
abnormal_line_data <- compound_data %>%
filter(Concentration_label %in% fully_abnormal_concs)
p <- p + geom_line(
data = abnormal_line_data,
aes(x = Time_min, y = mean, group = Concentration_label),
color = "grey50", size = 0.8, alpha = 0.7
)
}
}
}
p <- p +
scale_color_manual(
name = compound_name,
values = comp_palette,
labels = compound_labels,
breaks = breaks_order,
guide = guide_legend(
title = compound_name,
override.aes = list(size = 4),
title.theme = element_text(face = "bold", size = 12)
)
)
# Ajouter une nouvelle échelle de couleur pour le prochain composé
if (i < length(compounds_with_data)) {
p <- p + new_scale_color()
}
}
if (Outcome_format == "Normalized") {
p <- p + geom_hline(yintercept = 1, linetype = "dashed", color = "black", alpha = 0.6)
}
# Appliquer les limites et ticks personnalisés au graphique combiné à la fin
y_limits <- calculate_global_y_limits(full_plot_data)
p <- apply_custom_limits_and_ticks(p, y_limits)
return(p)
}
